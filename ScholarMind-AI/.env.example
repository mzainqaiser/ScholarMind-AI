# Copy to .env. No paid API keys are required anywhere in this project.
SCHOLARMIND_DATA_DIR=./storage/data
EMBEDDING_PROVIDER=auto            # auto | sentence-transformers | hashing (hashing = offline, non-semantic fallback)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct   # first run: ollama pull qwen2.5:3b-instruct
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
MIN_SCORE=0.12
MAX_UPLOAD_MB=20
AGENT_MAX_STEPS=12
